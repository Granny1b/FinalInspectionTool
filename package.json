{
  "name": "modig-final-inspection",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "app",
    "seed"
  ],
  "scripts": {
    "predev": "node api/scripts/ensure-local-settings.mjs",
    "dev": "concurrently --kill-others-on-fail --pad-prefix \"npm:dev:*\"",
    "dev:blob": "azurite-blob --location .azurite --silent --disableTelemetry --skipApiVersionCheck",
    "dev:table": "azurite-table --location .azurite --silent --disableTelemetry",
    "dev:seed": "wait-on --timeout 60s tcp:127.0.0.1:10000 tcp:127.0.0.1:10002 && npm run seed",
    "dev:api-build": "npm run watch -w @modig/api",
    "dev:api": "wait-on --timeout 120s file:api/dist/index.cjs tcp:127.0.0.1:10000 tcp:127.0.0.1:10002 && cd api && nodemon --exitcrash --watch dist --ext cjs --delay 1 --signal SIGTERM --exec \"func start --port 7071\"",
    "dev:app": "npm run dev -w @modig/app",
    "dev:swa": "wait-on --timeout 180s tcp:localhost:5173 http-get://127.0.0.1:7071/admin/host/status && swa start",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w @modig/seed --",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.10",
    "@azure/storage-blob": "^12.34.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "azurite": "^3.37.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}

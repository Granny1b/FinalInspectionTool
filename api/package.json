{
  "name": "@modig/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Azure Functions (Node v4 model) served by Azure Static Web Apps under /api, bundled with esbuild.",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prestart": "node scripts/ensure-local-settings.mjs",
    "start": "func start --port 7071",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.5",
    "@azure/storage-blob": "^12.34.0",
    "@modig/shared": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.15.2",
    "esbuild": "^0.28.2"
  }
}
